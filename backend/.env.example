# Copy to backend/.env  (all optional: the app runs fully in demo mode without any of these)

# --- Vision ---------------------------------------------------------------
VISION_PROVIDER=auto          # auto | yolo | opencv  (auto = YOLOv8 if installed, else OpenCV heuristic)
YOLO_WEIGHTS=yolov8n.pt
YOLO_CONFIDENCE=0.25
GEMINI_API_KEY=               # https://aistudio.google.com/apikey  enables snow/plowing/space judgement + hazard labels
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low

# --- Satellite (NOAA GOES-19, public, no key) ---------------------------------
SATELLITE_LIVE_ENABLED=true
GOES_SECTOR_URL=https://cdn.star.nesdis.noaa.gov/GOES19/ABI/SECTOR/ne/13/
GOES_IMAGE_SIZE=600x600
BUFFALO_PX_X=230              # UB's pixel in the sector image: calibrate before trusting live ETAs
BUFFALO_PX_Y=330
KM_PER_PX=2.0

# --- Weather (National Weather Service, public, no key) -----------------------
WEATHER_LIVE_ENABLED=true
NWS_USER_AGENT=WeParkit/1.0 (your-email@buffalo.edu)
NWS_STATION=KBUF

# --- Voice (ElevenLabs text-to-speech, optional) -------------------------------
ELEVENLABS_API_KEY=           # https://elevenlabs.io/app/settings/api-keys  enables spoken parking briefings
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# --- Login ------------------------------------------------------------------
AUTH_EMAIL_DOMAINS=buffalo.edu,gmail.com   # who may sign up with email + password
AUTH_VERIFY_EMAIL=false                    # true = 6-digit email code step (needs SMTP_* to email it)
# Google sign-in: OAuth client IDs from console.cloud.google.com (Web first, then Android/iOS), comma-separated.
GOOGLE_CLIENT_IDS=

# --- Lots ---
LOT_CAPACITY_TIERS=56,116,300               # small / mid / big lots by area rank (empty = MIN..MAX)
LOT_CAPACITY_MIN=15                        # lot capacities are scaled into MIN..MAX by lot size
LOT_CAPACITY_MAX=30                        # (0 = use the raw OSM area estimates)
LOT_CAPACITY_STEP=5
DEMO_FULL_LOTS=jarvis-a,ketter-lot,governors-c   # shown FULL as labelled demo data (empty = none)

# --- Decision engine --------------------------------------------------------
ICE_ARRIVAL_THRESHOLD_MIN=60
ICE_CAPACITY_REDUCTION_DEFAULT=0.18
ICE_DEPARTURE_BUFFER_MIN=12

# --- Expiry -----------------------------------------------------------------
PARKING_REPORT_TTL_MIN=30
ICE_HAZARD_TTL_HOURS=6

# --- Demo helpers -----------------------------------------------------------
SIM_CLOCK=                    # e.g. 09:40 to run the occupancy model as if it were morning
# DATABASE_URL=sqlite:///./data/weparkit.db   # default sqlite:///backend/data/weparkit.db
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081   # only matters for Expo web

# Images. Hackathon: keep privacy-blurred frames the student captures (Capture button) in data/captures/, never auto-delete.
# Production: CAPTURE_SAVE=false and MEDIA_RETENTION_HOURS=24 (or 1) for short-term caching of scan/hazard images only.
CAPTURE_SAVE=true
MEDIA_RETENTION_HOURS=0

# Object detector device: gpu (NVIDIA via OpenCL), cpu, or auto
VISION_DEVICE=auto
